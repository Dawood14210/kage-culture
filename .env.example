# ================================================================
# KAGE CULTURE — environment variables
# ================================================================

# ---- Local dev only (leave unset on Vercel) ----
# PORT defaults to 3000 locally; Vercel ignores it.

# ---- Session signing secret (REQUIRED in production) ----
# Any long random string. Keep it secret.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database: Turso (REQUIRED on Vercel) ----
# Create a free database at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
#
# If BOTH are unset, the app uses the local sql.js file DB (kage.db)
# for development. On Vercel they MUST be set — the serverless
# filesystem is ephemeral.

# ---- Image storage: Vercel Blob (REQUIRED on Vercel) ----
# Provisioned automatically when you add a Blob store to the Vercel
# project. Falls back to local ./uploads in development.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

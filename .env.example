# ================================================================
# KAGE Culture — Environment Variables
# Copy this file to .env and fill in the values
# ================================================================

# --- Required everywhere except local development/test ---
# The app REFUSES TO BOOT without this unless NODE_ENV is exactly
# 'development' or 'test' (the dev fallback string lives in this public repo,
# so any reachable deploy that used it could have its admin session forged).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=          # >= 32 characters; used to sign kage.session/kage.cust + CSRF tokens
TURSO_DATABASE_URL=      # Turso edge SQLite URL (libsql://...)
TURSO_AUTH_TOKEN=        # Turso auth token
RATE_LIMIT_STORE=         # Optional: set to db for shared DB-backed limits (automatic on Turso)

# --- Storage ---
BLOB_READ_WRITE_TOKEN=   # Required on Vercel; also accepts generated kage_READ_WRITE_TOKEN

# --- Optional: Admin ---
AUTO_CREATE_ADMIN=false  # Set to "true" only for serverless in-memory DBs
                         # WARNING: anyone with the email+password can create an admin

# --- Admin bootstrap (first-run only) ---
ALLOW_ADMIN_SETUP=false  # Set to "true" ONLY while creating the first admin on a
                         # fresh DB, then remove. When false, POST /api/admin/setup
                         # is disabled — the first visitor cannot claim your site.

# --- Optional: Email (password reset + order notifications) ---
EMAIL_API_KEY=           # Resend API key (or leave blank for dev mode logging)
EMAIL_FROM=              # Sender address (default: KAGE Culture <noreply@kage-culture.vercel.app>)
SITE_URL=                # Base URL for reset links (default: https://kage-culture-ruby.vercel.app)

# --- Optional: Server ---
PORT=3000                # Local dev port
NODE_ENV=                # 'development' locally, 'production' everywhere deployed.
                         # Anything other than development/test (including unset)
                         # makes SESSION_SECRET mandatory.

# NOTE: .env is NOT read by `node server.js` / `npm start` — nothing loads it
# automatically (no dotenv dependency). Only `npm run dev` reads it, via
# scripts/dev.js. Everywhere else, export the variables in the environment
# (shell `export`, Docker --env-file, Render/Railway/Vercel dashboards).

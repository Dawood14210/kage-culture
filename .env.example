# ================================================================
# KAGE Culture — Environment Variables
# Copy this file to .env and fill in the values
# ================================================================

# --- Required in production ---
SESSION_SECRET=          # Random string (min 32 chars) for cookie signing
TURSO_DATABASE_URL=      # Turso edge SQLite URL (libsql://...)
TURSO_AUTH_TOKEN=        # Turso auth token

# --- Optional: Storage ---
BLOB_READ_WRITE_TOKEN=   # Vercel Blob token for image uploads

# --- Optional: Admin ---
AUTO_CREATE_ADMIN=false  # Set to "true" only for serverless in-memory DBs
                         # WARNING: anyone with the email+password can create an admin

# --- Admin bootstrap (first-run only) ---
ALLOW_ADMIN_SETUP=false  # Set to "true" ONLY while creating the first admin on a
                         # fresh DB, then remove. When false, POST /api/admin/setup
                         # is disabled — the first visitor cannot claim your site.

# --- Optional: Email (password reset + order notifications) ---
EMAIL_API_KEY=           # Resend API key (or leave blank for dev mode logging)
EMAIL_FROM=              # Sender address (default: KAGE Culture <noreply@kage-culture.vercel.app>)
SITE_URL=                # Base URL for reset links (default: https://kage-culture-ruby.vercel.app)

# --- Optional: Server ---
PORT=3000                # Local dev port
NODE_ENV=                # Set to "production" on Vercel

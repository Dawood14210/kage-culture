# ================================================================
# KAGE Culture — Environment Variables
# Copy this file to .env and fill in the values
# ================================================================

# --- Required everywhere except local development/test ---
# The app REFUSES TO BOOT without this unless NODE_ENV is exactly
# 'development' or 'test' (the dev fallback string lives in this public repo,
# so any reachable deploy that used it could have its admin session forged).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# >= 32 characters; used to sign kage.session + CSRF tokens
SESSION_SECRET=
# Turso edge SQLite URL (libsql://...)
TURSO_DATABASE_URL=
# Turso auth token
TURSO_AUTH_TOKEN=
# Optional: set to db for shared DB-backed limits (automatic on Turso)
RATE_LIMIT_STORE=

# --- Storage ---
# Required on Vercel; also accepts generated kage_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# --- Optional: Admin ---
AUTO_CREATE_ADMIN=false  # Set to "true" only for serverless in-memory DBs
                         # WARNING: anyone with the email+password can create an admin

# --- Admin bootstrap (first-run only) ---
ALLOW_ADMIN_SETUP=false  # Set to "true" ONLY while creating the first admin on a
                         # fresh DB, then remove. When false, POST /api/admin/setup
                         # is disabled — the first visitor cannot claim your site.

# --- Optional: Email transport; required for production delivery ---
# Do NOT append a "# comment" after a value here. Even though `npm run dev`
# now strips one, a comment on SMTP_PORT/SMTP_PASS is the most common reason
# email silently stops working: the port stops being a number and the password
# gains the comment text. Put comments on their own line.
#
# Check what the app actually sees (and test the login) without sending mail:
#   GET  /api/admin/email/diagnostics
#   POST /api/admin/email/diagnostics/verify
# The boot log also prints one "📧 Email:" line and lists any problem.
#
# e.g. smtp.gmail.com; when set it takes precedence over Resend
SMTP_HOST=
# Gmail: 465 (implicit TLS) or 587 (STARTTLS). Port 25 is blocked by Vercel.
SMTP_PORT=465
# Full Gmail address, e.g. shop@example.com
SMTP_USER=
# Gmail App Password (16 characters, NOT the account password). Display spaces
# are harmless and removed automatically.
SMTP_PASS=
# Resend API key; used only when SMTP_HOST is unset (blank = dev log)
EMAIL_API_KEY=
# Optional sender; defaults to SMTP_USER for SMTP or KAGE Culture's Resend sender
EMAIL_FROM=
# Canonical public HTTPS origin, e.g. your own storefront domain.
# Required to send password-reset and verification links.
# If unset, page tags, sitemap and robots use the request origin; production
# logs a warning, and the two link-based emails are suppressed.
SITE_URL=
UMAMI_WEBSITE_ID=        # Umami Cloud website id (dashboard > Add website); enables the
                         # privacy-friendly analytics tag. Blank = no tag, no tracking.

# --- Optional: Server ---
PORT=3000                # Local dev port
NODE_ENV=                # 'development' locally, 'production' everywhere deployed.
                         # Anything other than development/test (including unset)
                         # makes SESSION_SECRET mandatory.

# NOTE: .env is NOT read by `node server.js` / `npm start` — nothing loads it
# automatically (no dotenv dependency). Only `npm run dev` reads it, via
# scripts/dev.js. Everywhere else, export the variables in the environment
# (shell `export`, Docker --env-file, Render/Railway/Vercel dashboards).
